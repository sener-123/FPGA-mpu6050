#------------------------------------------------------------------------------
# 文件名 : pgl22g.fdc
# 功能   : PDS（Pango Design Suite）时序约束：时钟
# 板卡   : ALINX PGL22G 开发板，板载 50MHz 晶振
#------------------------------------------------------------------------------
# 50MHz 主时钟：周期 20ns
create_clock -name clk -period 20 -waveform {0 10} [get_ports {clk}]

# I2C/UART 等异步外设接口不设输入输出延时约束（低速接口，时序裕量充足）
